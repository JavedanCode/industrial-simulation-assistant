# HTTP server
PORT=3000
CORS_ORIGIN=*

# Local storage (relative paths are resolved from the project root)
DATA_DIR=data
# DATABASE_PATH=data/assistant.db
# DATABASE_PATH=:memory:

# AI provider: "mock" works offline, "gemini" calls the hosted Gemini API.
AI_PROVIDER=mock

# Gemini is only used when AI_PROVIDER=gemini.
# Create a free API key at https://aistudio.google.com/apikey and keep it local.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=30000
